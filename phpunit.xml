<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!--
        These values cover a host run, where none of them exist in the process
        environment: PHPUnit sets them via putenv()/$_ENV and Laravel picks them up.
        force="true" additionally beats a stale $_ENV entry.

        It does NOT beat a real environment variable. Illuminate\Support\Env reads
        $_SERVER before $_ENV, and PHPUnit never writes $_SERVER, so inside the
        app container — where compose exports APP_ENV, DB_DATABASE, CACHE_STORE and
        friends for real — these declarations are silently ignored. That is why
        `make test` passes the same overrides with `docker compose exec -e`, and why
        Tests\TestCase refuses to run against any database but brgy_testing.
    -->
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- Real PostgreSQL, not :memory: sqlite: the schema leans on foreign
             keys with ON DELETE CASCADE / SET NULL, and those must be exercised
             against the engine that runs in production. The database itself is
             created by docker/postgres/init/01-create-testing-database.sql. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="postgres" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="brgy_testing" force="true"/>
        <env name="DB_USERNAME" value="brgy" force="true"/>
        <env name="DB_PASSWORD" value="secret" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
