# Barangay Profiling System — single-container nginx vhost.
#
# Rendered by docker/php/entrypoint.sh into /etc/nginx/http.d/default.conf at
# container start, because nginx has no equivalent of env() and the platform
# picks the port at runtime (Render injects 10000, Cloud Run and Container Apps
# 8080). Only ${PORT} is substituted — naming it explicitly stops envsubst from
# eating nginx's own $uri, $document_root and every other dollar variable here.
#
# This file is the deployable twin of docker/nginx/default.conf. That one is the
# dev vhost, served by the separate `nginx` compose service; this one lives
# inside the app container. Keep them in step. The differences are only:
#   * `listen ${PORT}` instead of 80
#   * `fastcgi_pass 127.0.0.1:9000` instead of the `app` service name
#   * temp paths under /tmp, because the container runs as the unprivileged
#     `app` user and cannot write /var/lib/nginx
#   * the HTTPS fastcgi_param, because a PaaS terminates TLS upstream
#
# http.d/*.conf is included inside nginx's `http` block on Alpine, so the
# http-context directives below are legal here and need no separate file.
client_body_temp_path /tmp/nginx-client-body;
proxy_temp_path       /tmp/nginx-proxy;
fastcgi_temp_path     /tmp/nginx-fastcgi;
uwsgi_temp_path       /tmp/nginx-uwsgi;
scgi_temp_path        /tmp/nginx-scgi;

# Laravel must be told the original scheme or it builds http:// URLs behind the
# platform's TLS terminator, which breaks every redirect and asset URL. A map
# rather than the raw header: the value has to be empty (not "off") for plain
# http, and passing the client's header through verbatim would let a request
# claim HTTPS=off and downgrade itself.
map $http_x_forwarded_proto $forwarded_https {
    default '';
    https   'on';
}

server {
    listen ${PORT};
    server_name _;

    root /var/www/html/public;
    index index.php;

    charset utf-8;
    client_max_body_size 32M;

    access_log /dev/stdout main;
    error_log  /dev/stderr warn;

    # ---- compression -----------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_types
        application/javascript
        application/json
        application/manifest+json
        application/rss+xml
        application/wasm
        application/xml
        font/woff
        font/woff2
        image/svg+xml
        text/css
        text/javascript
        text/plain
        text/xml;

    # ---- security headers ------------------------------------------------
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ---- health check ----------------------------------------------------
    # Laravel's built-in /up route (bootstrap/app.php, health: '/up'). Served
    # through php-fpm on purpose: a dead fpm then fails the platform's health
    # check and gets the container replaced, instead of silently 502-ing.
    location = /up {
        access_log off;
        try_files $uri /index.php?$query_string;
    }

    # ---- routing ---------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # ---- denies ----------------------------------------------------------
    # Dotfiles (.env, .git, ...) are never served.
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
        return 404;
    }

    location ~ ^/(storage/framework|vendor|node_modules)/ {
        deny all;
        return 404;
    }

    # Vite build output is content-hashed: cache it forever.
    location /build/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location ~* \.(?:css|js|mjs|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico|map)$ {
        access_log off;
        expires 30d;
        add_header Cache-Control "public" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri /index.php?$query_string;
    }

    # ---- PHP -------------------------------------------------------------
    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;

        include fastcgi_params;

        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTP_PROXY "";
        fastcgi_param HTTPS $forwarded_https if_not_empty;

        fastcgi_hide_header X-Powered-By;

        fastcgi_read_timeout 65s;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }
}
