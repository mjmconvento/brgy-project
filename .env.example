#===============================================================================
# Barangay Profiling System — environment template
#
#   cp .env.example .env
#   make setup
#
# Hostnames below (postgres, redis, mailpit) are compose service names, so this
# file works as-is inside Docker. compose.yaml re-exports the same values via
# `environment:` too, so a bare-metal run only has to point them at 127.0.0.1.
#===============================================================================

#-------------------------------------------------------------------------------
# Application
#-------------------------------------------------------------------------------
APP_NAME="Barangay Profiling System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

#-------------------------------------------------------------------------------
# Logging
#-------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#-------------------------------------------------------------------------------
# Database (PostgreSQL 18 — service `postgres`)
#
# The compose image creates DB_DATABASE owned by DB_USERNAME on first boot, and
# that account is the cluster superuser, so there is no separate root password.
#-------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=brgy
DB_USERNAME=brgy
DB_PASSWORD=secret

#-------------------------------------------------------------------------------
# Cache / session / queue (Redis 8.10 — service `redis`)
#-------------------------------------------------------------------------------
CACHE_STORE=redis
# CACHE_PREFIX=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

#-------------------------------------------------------------------------------
# Mail (Mailpit — service `mailpit`, UI on http://localhost:8025)
#
# Registration sends an email verification link and the app stays closed until
# it is clicked, so mail has to work everywhere the app runs. Locally Mailpit
# catches it. In production MAIL_MAILER=brevo sends over Brevo's HTTPS API —
# Render's free tier blocks outbound SMTP — and the MAIL_HOST/PORT/USERNAME/
# PASSWORD lines are then inert. Walkthrough: ai_docs/email-verification.md.
#
# Escape hatch when no email arrives:  php artisan email:verification-link you@example.com
#-------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# With MAIL_MAILER=brevo this must be EXACTLY a sender validated in Brevo, or
# every send fails with `400 sender not valid`.
MAIL_FROM_ADDRESS="noreply@brgy.local"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo API key: https://app.brevo.com/settings/keys/api, prefix `xkeysib-`.
# NOT the SMTP key on the neighbouring tab — only the API key works over HTTPS.
# Leave empty locally; set on Render.
BREVO_API_KEY=

#-------------------------------------------------------------------------------
# AWS (unused by default)
#-------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#-------------------------------------------------------------------------------
# Frontend
#-------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

#-------------------------------------------------------------------------------
# Docker knobs — read by compose.yaml, not by Laravel
#
#   APP_PORT          published http port (nginx)
#   DB_PORT_FORWARD   published postgres port on the host
#   REDIS_PORT_FORWARD published redis port on the host
#   VITE_PORT         published vite dev-server port
#   MAILPIT_PORT      published mailpit web UI port
#   UID / GID         host user ids baked into the image so bind-mounted
#                     files stay writable on Linux
#   RUN_MIGRATIONS    when true the entrypoint runs `migrate --force` on boot
#-------------------------------------------------------------------------------
APP_PORT=8000
DB_PORT_FORWARD=5432
REDIS_PORT_FORWARD=6379
VITE_PORT=5173
MAILPIT_PORT=8025
UID=1000
GID=1000
RUN_MIGRATIONS=false
